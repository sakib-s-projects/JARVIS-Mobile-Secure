# Preferred no-paid-provider staging path (requires the separate Cloudflare adapter Worker).
# Configure both values together; never reuse JARVIS_RELAY_TOKEN or any admin/session secret.
# JARVIS_CLOUDFLARE_RELAY_URL=https://jarvis-relay-adapter-staging.<your-subdomain>.workers.dev
# JARVIS_CLOUDFLARE_RELAY_TOKEN=replace-with-a-distinct-random-secret-at-least-32-characters

# Optional paid-provider path. Leave unset when using the approved Cloudflare Gemini/Groq route.
# OPENAI_API_KEY=sk-...

JARVIS_RELAY_TOKEN=replace-with-a-long-random-secret
JARVIS_SAFETY_ID=jarvis-personal

# Legacy compatibility: use only if an existing deployment still needs the old name.
# ORBIT_RELAY_TOKEN=replace-with-a-long-random-secret
# ORBIT_SAFETY_ID=orbit-personal

# Temporary rotation only: previous token is accepted until this Unix timestamp (UTC seconds).
# Remove both previous-token settings after clients have switched to the new primary token.
# JARVIS_RELAY_TOKEN_PREVIOUS=old-long-random-secret
# JARVIS_RELAY_TOKEN_PREVIOUS_EXPIRES_AT=1790000000
